# Exemple uniquement : aucun secret réel. Le fichier réel reste sur le serveur.
# /etc/nextech/application.env, root:nextech 0640, chargé par systemd.
DATABASE_URL=postgresql://APP_USER:REPLACE_ME@localhost/APP_DATABASE
PUBLIC_ORIGIN=https://v3.nextechlogistic.fr
NEXTECH_DOMAIN=v3.nextechlogistic.fr
PORT=3000
SHOP_VAULT_FILE=/var/lib/nextech-live/temu-shops.json
# Conserver les valeurs métier existantes ; le pipeline ne les modifie pas.
