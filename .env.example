# Copier en .env et renseigner les valeurs privees.
# Le suivi dedie (bouton V3 et CLI) lit .env.
# Les autres connecteurs historiques utilisent leurs fichiers JSON.
DATABASE_URL=
ERPLAIN_API_KEY=
ERPLAIN_COMPANY_ID=100174
# 1 autorise les mises a jour Erplain du processus lance avec --apply.
ERPLAIN_LIVE_WRITES=0
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_ACCESS_TOKEN=
GLS_TRACK_TRACE_CLIENT_ID=
GLS_TRACK_TRACE_CLIENT_SECRET=
GOFO_APP_ID=
GOFO_APP_SECRET=
GOFO_BASE_URL=https://api-eu.gofoexpress.com
# Alternative aux variables API : repertoire des fichiers JSON prives existants.
CREDENTIALS_DIR=
TRACKING_SYNC_INTERVAL_SECONDS=1800
# Par defaut : data/tracking-sync-report.json (exclu de Git).
TRACKING_SYNC_REPORT=
